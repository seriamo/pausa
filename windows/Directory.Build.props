<Project>
  <PropertyGroup>
    <!-- Single source of truth for the Windows app version. Release tags are windows-v<Version>. -->
    <Version>1.0.0</Version>
    <Product>Pausa</Product>
    <Company>Seriamo</Company>
    <Authors>Seriamo</Authors>
    <Copyright>Copyright (c) 2026 Seriamo</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Lets the WPF project compile on macOS/Linux; it still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
